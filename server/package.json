{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"import('fs/promises').then(fs=>fs.copyFile('src/db/schema.sql','dist/db/schema.sql').then(()=>fs.cp('src/trace/demo','dist/trace/demo',{recursive:true})))\"",
    "start": "node dist/index.js",
    "worker": "tsx watch src/worker/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:worker": "tsx src/test/queue.integration.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "user:reset-password": "tsx src/db/reset-password.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "openai": "^7.25.0",
    "pg": "^8.13.1",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
