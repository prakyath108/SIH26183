# ---- Core ----
# Single-origin host: the API also serves the built SPA from web/dist, so the
# whole app lives on this one port. Keep NODE_ENV=development for `npm run dev`
# and the db:* scripts; start-server.ps1 sets production when hosting.
NODE_ENV=development
PORT=8080
# Loopback only. Use 0.0.0.0 to expose the app to your local network.
HOST=127.0.0.1
# Origin allowed to call the API
CORS_ORIGIN=http://localhost:8080
# WebSocket server port for real-time streaming
WS_PORT=8081

# ---- Auth ----
# CHANGE THIS. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production startup refuses placeholders and low-entropy secrets.
JWT_SECRET=dev-only-insecure-secret-change-me
# Access tokens are deliberately short-lived. The SPA refreshes silently on
# 401; refresh tokens are single-use and rotated on every exchange.
JWT_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=7

# ---- Database ----
# Leave empty to use embedded Postgres (PGlite) stored in ./data
# For real Postgres: postgresql://cryptotrace:cryptotrace@localhost:5432/cryptotrace
DATABASE_URL=
PGPOOL_MAX=10

# ---- Blockchain data sources (all optional; keyless tiers used when blank) ----
# https://mempool.space/docs/api/rest | Bitcoin
MEMPOOL_API=https://mempool.space/api
# Ethereum JSON-RPC. Public nodes flap (Cloudflare in particular intermittently
# answers with a null result), so several are listed and tried in order.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_RPC_FALLBACKS=https://eth.llamarpc.com,https://eth.drpc.org,https://1rpc.io/eth
# Optional, raises rate limits: https://dashboard.etherscan.io
ETHERSCAN_API_KEY=
# https://developers.tron.network | Tron
TRONGRID_API=https://api.trongrid.io
TRONGRID_API_KEY=
# Polygon JSON-RPC (https://polygon-rpc.com is retired and returns 401)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_FALLBACKS=https://polygon.drpc.org,https://1rpc.io/matic
# https://polygonscan.com | Polygon
POLYGONSCAN_API_KEY=

# ---- Indian LE Intelligence (Sahyog/NCRP) ----
# https://sahyog.gov.in | Law enforcement intelligence sharing
SAHYOG_API_URL=https://api.sahyog.gov.in
SAHYOG_API_KEY=
# https://ncrp.gov.in | National Cybercrime Reporting Portal
NCRP_API_URL=https://api.ncrp.gov.in
NCRP_API_KEY=

# ---- AI document analysis (optional) ----
# Leave OPENAI_API_KEY blank and every AI route returns 503 with a typed reason.
# Nothing else in the platform depends on it.
OPENAI_API_KEY=
# gpt-4o-mini is markedly cheaper and sufficient for indicator extraction;
# use gpt-4o for long or ambiguous forensic documents.
OPENAI_MODEL=gpt-4o-mini
# Set to false to keep the key in the environment while refusing to send case
# material to a third party.
AI_ENABLED=true
# Uploads above this size are rejected before anything is written to disk.
AI_MAX_UPLOAD_MB=20
# Characters of extracted text sent per analysis call.
AI_MAX_INPUT_CHARS=60000
AI_TIMEOUT_MS=90000
# Concurrent analyses, to bound upstream spend.
AI_MAX_CONCURRENT=3

# ---- Advisory ML risk service (optional) ----
# Leave RISK_SERVICE_URL empty to disable the advisory entirely. That is the
# correct state until a model has been trained: the service returns
# ready=false/score=null rather than a fabricated number.
#
# To enable: train a model, then point this at the service.
#   cd services/risk-service
#   python train.py --input <routine-traversals.jsonl> --out models/risk.joblib
#   python -m uvicorn app.main:app --port 8099
#   # then set RISK_SERVICE_URL=http://127.0.0.1:8099
RISK_SERVICE_URL=
# Per-call budget. The advisory sits on the request path, so it fails open
# rather than delaying or failing a case.
RISK_SERVICE_TIMEOUT_MS=1500

# Band edges for the advisory score, as ascending percentiles of the model's
# training sample. Each implies that share of routine traffic above it, so the
# default top band (97) puts roughly 3% of ordinary traffic in the queue.
# Raise the last value toward 99 for a shorter queue.
# Labels must be one longer than the number of edges. An unparseable value is
# ignored in favour of the defaults.
# RISK_BAND_EDGES=50,75,90,97
# RISK_BAND_LABELS=Typical,Above typical,Unusual,Rare,Very rare
