# ---- Container hosting secrets ---------------------------------------------
#
# This file is NOT the same as the development `.env` at the repository root.
# Docker Compose auto-loads `.env` for variable substitution, which would
# silently feed the development config into a production container. So use an
# explicit filename and pass it:
#
#   docker compose --env-file .env.docker up -d --build
#
# Copy this file to `.env.docker`, fill in the two secrets below, and keep it
# out of version control (it is already covered by `.gitignore`'s `.env.*`).
#
# Only JWT_SECRET and POSTGRES_PASSWORD are required. Everything else has a
# working default in docker-compose.yml.

# ---- Required ---------------------------------------------------------------

# Signs access tokens. The app refuses to start in production if this is under
# 32 characters, has fewer than 12 distinct characters, or contains a
# placeholder fragment like "changeme" or "example".
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Database password for the bundled Postgres. Change the default, especially if
# port 5432 is ever published beyond loopback.
POSTGRES_PASSWORD=

# ---- Optional: exposure -----------------------------------------------------

# Host port to publish the app on. Defaults to 8080. Loopback-bound.
# CRYPTOTRACE_PORT=8080

# Must match the origin you actually browse from, or the browser will block
# API calls. Set this the moment you put a hostname or reverse proxy in front.
# CORS_ORIGIN=https://cryptotrace.example.com

# WebSocket server port for real-time streaming (separate from main API port)
# WS_PORT=8081

# ---- Optional: TLS termination (the `tls` profile) --------------------------
#
# These take effect only with `docker compose --profile tls up`.
# See deploy/Caddyfile and deploy/nginx.conf.

# The public hostname Caddy should get a certificate for. It has to resolve to
# this host over the public internet, so it cannot be localhost. Required by
# the tls profile.
# DOMAIN=cryptotrace.example.com

# Address used for Let's Encrypt expiry notices.
# Set this to the literal value `internal` to use Caddy's own local CA instead,
# which is how the offline TLS check in the README works.
# ACME_EMAIL=you@example.com

# Interface to bind ports 80/443 on. Defaults to 0.0.0.0, because this is the
# public entry point. Set to 127.0.0.1 when a cloud load balancer already
# terminates TLS and forwards to this host.
# PROXY_BIND=0.0.0.0

# ---- Optional: session tuning ----------------------------------------------

# JWT_EXPIRES_IN=15m
# JWT_REFRESH_TTL_DAYS=7
# PGPOOL_MAX=10

# ---- Optional: first-run seed ----------------------------------------------

# Credentials created by `node server/dist/db/seed.js`. Read once at seed time.
# Set these before seeding if you do not want the documented demo passwords, and
# delete or deactivate the demo accounts before going live.
# SEED_ADMIN_EMAIL=admin@cryptotrace.local
# SEED_ADMIN_PASSWORD=ChangeMe!2026Admin

# ---- Optional: chain data sources ------------------------------------------
# Blank values use the keyless public endpoints.
# ETHERSCAN_API_KEY=
# TRONGRID_API_KEY=
# POLYGONSCAN_API_KEY=
# SAHYOG_API_KEY=
# NCRP_API_KEY=
# SAHYOG_API_URL=https://api.sahyog.gov.in
# NCRP_API_URL=https://api.ncrp.gov.in
# ---- Optional: AI document assistant ---------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_ENABLED=true
# AI_MAX_UPLOAD_MB=20
# AI_MAX_INPUT_CHARS=60000
# AI_TIMEOUT_MS=90000
# AI_MAX_CONCURRENT=3

# ---- Advisory ML risk service (optional) ----
# Inside compose the service name resolves on the internal network. Set this to
# http://risk:8099 to enable it, or leave empty to disable.
#
# The service ships without a model on purpose. Mount a trained artifact at
# /app/models (see the risk service's volumes in docker-compose.yml) and set
# MODEL_PATH; until then it serves ready=false/score=null, which is correct
# rather than broken.
RISK_SERVICE_URL=
RISK_SERVICE_TIMEOUT_MS=1500

# Band edges for the advisory score, as ascending percentiles of the model's
# training sample. Each implies that share of routine traffic above it, so the
# default top band (97) puts roughly 3% of ordinary traffic in the queue.
# Raise the last value toward 99 for a shorter queue.
# Labels must be one longer than the number of edges. An unparseable value is
# ignored in favour of the defaults.
# RISK_BAND_EDGES=50,75,90,97
# RISK_BAND_LABELS=Typical,Above typical,Unusual,Rare,Very rare
